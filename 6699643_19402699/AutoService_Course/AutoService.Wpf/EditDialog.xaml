<Window x:Class="AutoService.Wpf.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор записи" Width="580" Height="660" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F7FA" FontFamily="Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Grid.Row="0" FontSize="22" Foreground="#173148" FontWeight="SemiBold" Margin="0,0,0,17"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" MinWidth="115" Click="Save_Click"/>
            <Button Content="Отмена" MinWidth="100" Background="#64748B" Margin="0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
